PORT=1337
NODE_ENV=production
KONGA_HOOK_TIMEOUT=120000
DB_ADAPTER=postgres
DB_URI=postgresql://localhost:5432/konga

# Connect to the database over TLS. Anything other than
# false / 0 / no / off (or unset) turns it on.
# DB_SSL=true
# Verify the database server's certificate. Off by default so that
# self-signed certificates keep working.
# DB_SSL_REJECT_UNAUTHORIZED=true
# Put konga's tables in a schema other than `public` (postgres only).
# DB_PG_SCHEMA=konga

KONGA_LOG_LEVEL=warn
TOKEN_SECRET=some_secret_token
